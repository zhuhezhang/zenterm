{
  "name": "zterm",
  "version": "1.0.0",
  "author": "zhuhezhang",
  "description": "A terminal emulator with SSH, SFTP, Telnet and Serial support",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "build": "vite build && electron-builder",
    "vite": "vite",
    "electron": "electron .",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && nodemon --watch electron --ext js,json --exec \"electron .\""
  },
  "dependencies": {
    "react-devtools": "^7.0.1",
    "serialport": "^12.0.0",
    "ssh2": "^1.15.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "electron-devtools-installer": "^4.0.0",
    "nodemon": "^3.1.14",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vite": "^5.0.8",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.zterm.app",
    "productName": "ZTerm",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ]
  }
}
