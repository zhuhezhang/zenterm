{
  "name": "zterm",
  "version": "1.2.3",
  "description": "A terminal emulator with SSH, SFTP, Telnet and Serial support",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:silent": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron:silent\"",
    "build": "vite build && electron-builder",
    "build:win": "vite build && electron-builder --win",
    "build:win:x64": "vite build && electron-builder --win --x64",
    "build:win:ia32": "vite build && electron-builder --win --ia32",
    "build:win:x64:portable": "vite build && electron-builder --win portable --x64",
    "build:linux": "vite build && electron-builder --linux",
    "build:linux:x64": "vite build && electron-builder --linux --x64",
    "build:linux:x64:appimage": "vite build && electron-builder --linux AppImage --x64",
    "build:mac": "vite build && electron-builder --mac",
    "build:mac:arm64": "vite build && electron-builder --mac --arm64",
    "build:mac:universal": "vite build && electron-builder --mac --universal",
    "build:x64:linux-appimage-win-portable-nsis": "vite build && electron-builder --win portable nsis --x64 --linux AppImage --x64",
    "vite": "vite",
    "electron": "electron .",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && nodemon --watch electron --ext js,json --exec \"electron .\"",
    "dev:electron:silent": "wait-on tcp:5173 && nodemon --watch electron --ext js,json --exec \"cross-env ELECTRON_DISABLE_SECURITY_WARNINGS=1 electron .\""
  },
  "dependencies": {
    "iconv-lite": "^0.6.3",
    "serialport": "^12.0.0",
    "ssh2": "^1.15.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react-oxc": "^0.4.3",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "electron-devtools-installer": "^4.0.0",
    "nodemon": "^3.1.14",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vite": "^8.0.11",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.zterm.app",
    "productName": "ZTerm",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "category": "Utility"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220,
          "type": "file"
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "author": {
    "name": "zhuhezhang",
    "email": "zhuhezhang@qq.com",
    "url": "https://github.com/zhuhezhang"
  },
  "license": "MIT"
}
