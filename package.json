{
  "name": "zterm",
  "version": "1.0.0",
  "author": "zhuhezhang",
  "description": "A terminal emulator with SSH, SFTP, Telnet and Serial support",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "build": "vite build && electron-builder",
    "build:win": "vite build && electron-builder --win",
    "build:win:x64": "vite build && electron-builder --win --x64",
    "build:win:ia32": "vite build && electron-builder --win --ia32",
    "build:win:portable": "vite build && electron-builder --win --x64 portable",
    "build:linux": "vite build && electron-builder --linux",
    "build:linux:x64": "vite build && electron-builder --linux --x64",
    "build:linux:ia32": "vite build && electron-builder --linux --ia32",
    "build:linux:appimage": "vite build && electron-builder --linux --target AppImage",
    "build:mac": "vite build && electron-builder --mac",
    "build:mac:x64": "vite build && electron-builder --mac --x64",
    "build:mac:arm64": "vite build && electron-builder --mac --arm64",
    "build:mac:universal": "vite build && electron-builder --mac --universal",
    "build:linux-appimage-win-portable-nsis": "vite build && electron-builder --win portable nsis --linux AppImage",
    "vite": "vite",
    "electron": "electron .",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && nodemon --watch electron --ext js,json --exec \"electron .\""
  },
  "dependencies": {
    "react-devtools": "^7.0.1",
    "serialport": "^12.0.0",
    "ssh2": "^1.15.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "electron-devtools-installer": "^4.0.0",
    "nodemon": "^3.1.14",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vite": "^5.0.8",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.zterm.app",
    "productName": "ZTerm",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": ["nsis", "portable", "zip"],
      "sign": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": ["AppImage", "deb", "tar.gz"],
      "category": "Utility"
    },
    "mac": {
      "target": ["dmg", "zip"]
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220,
          "type": "file"
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
