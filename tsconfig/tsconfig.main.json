{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "../dist-electron",
    "rootDir": "..",
    "noImplicitAny": true,
    "strictNullChecks": true,
    "declaration": false,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["../electron/**/*.ts", "../shared/**/*.ts", "../electron/types/**/*.d.ts"],
  "exclude": ["../electron/preload.ts"]
}
